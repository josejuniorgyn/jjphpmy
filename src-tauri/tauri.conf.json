{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "jjphpmy",
  "version": "0.1.0",
  "identifier": "br.com.jjphpmy.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "JJPHPMY",
        "width": 980,
        "height": 700,
        "minWidth": 780,
        "minHeight": 540,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "PortugueseBR"
        ]
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIwQTU5NDFGMUQyNTUwOTAKUldTUVVDVWRINVNsc0hRSk5JYTdvWGhVRnNkbi9NR2RadytNZlJHcjhYblpHM3NYMWZYdmF4U3QK",
      "endpoints": [
        "https://github.com/josejuniorgyn/jjphpmy/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
